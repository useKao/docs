{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Kao",
  "description": "Customer guides for setting up Kao, importing emotes, and managing Discord server emojis.",
  "colors": {
    "primary": "#3B82F6",
    "light": "#60A5FA",
    "dark": "#2563EB"
  },
  "appearance": {
    "default": "dark"
  },
  "favicon": "/favicon.ico",
  "logo": {
    "light": "/images/logo.png",
    "dark": "/images/logo.png",
    "href": "/"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "navbar": {
    "links": [
      {
        "label": "Pricing",
        "href": "https://usekao.com/pricing"
      },
      {
        "label": "Discord",
        "href": "https://usekao.com/api/discord/invite"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "https://usekao.com/"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Start here",
            "icon": "rocket",
            "expanded": true,
            "pages": ["introduction", "quickstart", "concepts/overview"]
          },
          {
            "group": "Bot setup",
            "icon": "bot",
            "pages": ["concepts/bot-system", "guides/multiple-bots", "guides/bot-commands"]
          },
          {
            "group": "Emoji workflows",
            "icon": "smile",
            "pages": [
              "guides/importing-emotes",
              "guides/managing-emojis",
              "guides/collections",
              "guides/emote-creator"
            ]
          },
          {
            "group": "Automation",
            "icon": "refresh-cw",
            "pages": [
              "guides/backups",
              "guides/rotations",
              "guides/sync-groups",
              "guides/activity-log"
            ]
          },
          {
            "group": "Account and settings",
            "icon": "settings",
            "pages": ["guides/server-settings", "guides/billing", "guides/account-management"]
          }
        ]
      },
      {
        "tab": "Resources",
        "groups": [
          {
            "group": "Support",
            "icon": "circle-help",
            "pages": ["resources/faq", "resources/troubleshooting"]
          },
          {
            "group": "Updates",
            "icon": "bell",
            "pages": ["resources/changelog"]
          }
        ]
      }
    ]
  },
  "search": {
    "prompt": "Search Kao documentation..."
  },
  "footer": {
    "socials": {
      "discord": "https://usekao.com/api/discord/invite"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          {
            "label": "Features",
            "href": "https://usekao.com/#features"
          },
          {
            "label": "Pricing",
            "href": "https://usekao.com/pricing"
          }
        ]
      },
      {
        "header": "Resources",
        "items": [
          {
            "label": "Documentation",
            "href": "https://docs.usekao.com"
          },
          {
            "label": "Support",
            "href": "https://usekao.com/api/discord/invite"
          }
        ]
      },
      {
        "header": "Legal",
        "items": [
          {
            "label": "Privacy",
            "href": "https://usekao.com/privacy"
          },
          {
            "label": "Terms",
            "href": "https://usekao.com/terms"
          }
        ]
      }
    ]
  },
  "seo": {
    "indexing": "navigable"
  }
}
